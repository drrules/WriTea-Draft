{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "WriTea Draft",
  "version": "1.1.84",
  "identifier": "net.japanada.writea-draft",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "cd frontend && npm run dev",
    "beforeBuildCommand": "cd frontend && npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "splashscreen",
        "url": "splash.html",
        "title": "WriTea Draft",
        "width": 480,
        "height": 420,
        "resizable": false,
        "decorations": false,
        "center": true,
        "transparent": true
      },
      {
        "label": "main",
        "url": "index.html",
        "title": "WriTea Draft",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri://localhost asset://localhost https://asset.localhost http://asset.localhost; script-src 'self' tauri://localhost https://accounts.google.com 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' tauri://localhost 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' tauri://localhost https://fonts.gstatic.com; img-src 'self' tauri://localhost asset://localhost https://asset.localhost http://asset.localhost https: data: blob:; connect-src 'self' tauri://localhost asset://localhost https://asset.localhost http://asset.localhost wss: ws: https: http://localhost:* http://127.0.0.1:*; frame-src https://www.youtube-nocookie.com https://player.vimeo.com https://accounts.google.com blob:; media-src 'self' tauri://localhost asset://localhost https://asset.localhost http://asset.localhost blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 26
    },
    "iOS": {
      "minimumSystemVersion": "15.0"
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "nsis-hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "desktopTemplate": "linux/hidden-launcher.desktop",
        "files": {
          "/usr/share/applications/writeadraft.desktop": "linux/writeadraft.desktop",
          "/usr/share/mime/packages/writeadraft.xml": "linux/writeadraft-mime.xml",
          "/usr/share/icons/hicolor/48x48/mimetypes/application-x-writea.png": "linux/icons/png/application-x-writea-48.png",
          "/usr/share/icons/hicolor/64x64/mimetypes/application-x-writea.png": "linux/icons/png/application-x-writea-64.png",
          "/usr/share/icons/hicolor/128x128/mimetypes/application-x-writea.png": "linux/icons/png/application-x-writea-128.png",
          "/usr/share/icons/hicolor/256x256/mimetypes/application-x-writea.png": "linux/icons/png/application-x-writea-256.png",
          "/usr/share/icons/hicolor/48x48/mimetypes/application-x-fdx.png": "linux/icons/png/application-x-fdx-48.png",
          "/usr/share/icons/hicolor/64x64/mimetypes/application-x-fdx.png": "linux/icons/png/application-x-fdx-64.png",
          "/usr/share/icons/hicolor/128x128/mimetypes/application-x-fdx.png": "linux/icons/png/application-x-fdx-128.png",
          "/usr/share/icons/hicolor/256x256/mimetypes/application-x-fdx.png": "linux/icons/png/application-x-fdx-256.png"
        }
      }
    },
    "category": "public.app-category.productivity",
    "fileAssociations": [
      {
        "ext": ["writea"],
        "mimeType": "application/x-writea",
        "description": "WriTea Draft Script"
      },
      {
        "ext": ["fdx"],
        "mimeType": "application/xml",
        "description": "Final Draft Screenplay"
      },
      {
        "ext": ["fountain"],
        "mimeType": "text/plain",
        "description": "Fountain Screenplay"
      },
      {
        "ext": ["fadein"],
        "mimeType": "application/zip",
        "description": "Fade In Screenplay"
      },
      {
        "ext": ["osf"],
        "mimeType": "application/xml",
        "description": "Open Screenplay Format"
      },
      {
        "ext": ["txt"],
        "mimeType": "text/plain",
        "description": "Text File"
      }
    ]
  },
  "plugins": {}
}
